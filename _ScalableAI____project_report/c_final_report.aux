\newlabel{sub@fig:k4_best_score}{{a}{7}{Best score vs.\ wall-clock time}{figure.caption.7}{}}
\newlabel{fig:k4_candidates}{{4b}{7}{Candidates generated vs.\ wall-clock time}{figure.caption.7}{}}
