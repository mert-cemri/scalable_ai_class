\newlabel{sec:results-spec}{{6.5}{7}{Speculative Pipelining}{subsection.6.5}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {6.5.1}$K{=}4$: Throughput Gains with an Eval-Time Trade-off}{7}{subsubsection.6.5.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\numberline {6.5.2}$K{=}8$: System Advantage but Pronounced Quality Regression}{7}{subsubsection.6.5.2}\protected@file@percent }
\newlabel{sec:k8spec}{{6.5.2}{7}{$K{=}8$: System Advantage but Pronounced Quality Regression}{subsubsection.6.5.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Circle Packing ($K{=}4$ spec): mean iteration time decomposed into LLM generation and Eval/Other, conditioned on speculation outcome. Pooled across 3 runs (spec-hit $n{=}108$, non-hit $n{=}304$). Spec-hit iterations recover $\sim $47\,s of LLM time but incur $\sim $58\,s of additional evaluation latency, leaving total iteration wall time roughly even.}}{8}{figure.caption.8}\protected@file@percent }
\newlabel{fig:k4_spec_breakdown}{{5}{8}{Circle Packing ($K{=}4$ spec): mean iteration time decomposed into LLM generation and Eval/Other, conditioned on speculation outcome. Pooled across 3 runs (spec-hit $n{=}108$, non-hit $n{=}304$). Spec-hit iterations recover $\sim $47\,s of LLM time but incur $\sim $58\,s of additional evaluation latency, leaving total iteration wall time roughly even}{figure.caption.8}{}}
\newlabel{fig:k8_best_score}{{6a}{8}{Best score vs.\ wall-clock time}{figure.caption.9}{}}
\newlabel{sub@fig:k8_best_score}{{a}{8}{Best score vs.\ wall-clock time}{figure.caption.9}{}}
\newlabel{fig:k8_candidates}{{6b}{8}{Candidates generated vs.\ wall-clock time}{figure.caption.9}{}}
\newlabel{sub@fig:k8_candidates}{{b}{8}{Candidates generated vs.\ wall-clock time}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces  Comparison between standard and speculative generation for Circle Packing under $K{=}8$. (a) shows a severe quality regression under speculation: the non-speculative run saturates near 1.0 within 30 minutes, while the speculative variant stagnates around $0.975$. (b) shows that the speculative variant still generates slightly more candidates per hour, indicating the regression arises from degraded search quality rather than insufficient throughput. }}{8}{figure.caption.9}\protected@file@percent }
\newlabel{fig:k8_spec_comparison}{{6}{8}{Comparison between standard and speculative generation for Circle Packing under $K{=}8$. (a) shows a severe quality regression under speculation: the non-speculative run saturates near 1.0 within 30 minutes, while the speculative variant stagnates around $0.975$. (b) shows that the speculative variant still generates slightly more candidates per hour, indicating the regression arises from degraded search quality rather than insufficient throughput}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Circle Packing ($K{=}8$ spec): mean iteration time by speculation outcome, pooled across 3 runs (spec-hit $n{=}120$, non-hit $n{=}424$; clipped at 360\,s). Spec-hit iterations are faster end-to-end ($158.5$ vs.\ $255.8\,\text  {s}$), yet Figure~\ref {fig:k8_best_score} shows this speed comes at a steep search-quality cost.}}{9}{figure.caption.10}\protected@file@percent }
\newlabel{fig:k8_spec_breakdown}{{7}{9}{Circle Packing ($K{=}8$ spec): mean iteration time by speculation outcome, pooled across 3 runs (spec-hit $n{=}120$, non-hit $n{=}424$; clipped at 360\,s). Spec-hit iterations are faster end-to-end ($158.5$ vs.\^^M$255.8\,\text {s}$), yet Figure~\ref {fig:k8_best_score} shows this speed comes at a steep search-quality cost}{figure.caption.10}{}}
