\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces  Comparison between standard and speculative generation for Circle Packing under $K{=}4$. (a) shows the best score over wall-clock time, where speculation provides a modest early lead that closes as the task saturates. (b) shows the number of generated candidates over time, where the speculative variant consistently achieves higher throughput. }}{7}{figure.caption.7}\protected@file@percent }
\newlabel{fig:k4_spec_comparison}{{4}{7}{Comparison between standard and speculative generation for Circle Packing under $K{=}4$. (a) shows the best score over wall-clock time, where speculation provides a modest early lead that closes as the task saturates. (b) shows the number of generated candidates over time, where the speculative variant consistently achieves higher throughput}{figure.caption.7}{}}
