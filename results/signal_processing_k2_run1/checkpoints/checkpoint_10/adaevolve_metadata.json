    "active_paradigms": [
      {
        "idea": "Use scipy.signal.savgol_filter with adaptive polynomial order",
        "description": "Replace exponential smoothing with Savitzky-Golay filter which fits local polynomials to smooth data while preserving signal features and derivatives. The filter uses a window and polynomial order to balance smoothness vs responsiveness. For each segment of the signal, we can adapt the polynomial order based on local volatility - higher order for smooth regions, lower order for volatile regions. This directly addresses slope changes and false reversals while maintaining tracking accuracy. The filter is deterministic and fast, avoiding the hysteresis issues in the current implementation.",
        "what_to_optimize": "Slope changes (S), false reversals (R), and correlation with clean signal",
        "cautions": "Window size must be odd and >= polynomial order + 2. Choose window size close to input window_size. Polynomial order typically 2-4. Edge handling may need special treatment.",
        "approach_type": "scipy.signal.savgol_filter"
      },
      {
        "idea": "Use scipy.signal.wiener filter with adaptive noise estimation",
        "description": "Implement Wiener filter which is optimal for stationary Gaussian noise but can be adapted for non-stationary signals. The filter estimates local noise variance and signal variance to compute optimal smoothing strength at each point. This provides better noise reduction than simple averaging while preserving signal dynamics. We can estimate noise variance from high-frequency components and signal variance from low-frequency components within each window. This directly improves L_avg and noise_reduction metrics while maintaining responsiveness.",
        "what_to_optimize": "Average tracking error (L_avg), noise reduction, and correlation with clean signal",
        "cautions": "Wiener filter assumes some stationarity within window. May need to estimate noise variance carefully. Works best when noise is approximately Gaussian. Window size affects estimation accuracy.",
        "approach_type": "scipy.signal.wiener"
      },
      {
        "idea": "Use scipy.signal.medfilt with multi-stage cascade for outlier rejection",
        "description": "Apply cascaded median filters to first remove outliers and spikes, then apply a lighter smoothing pass. Median filtering is robust to outliers and preserves edges better than mean-based filters. A two-stage approach: first medfilt with larger window removes spikes, then second medfilt with smaller window smooths remaining noise. This combination reduces false reversals caused by noise spikes while maintaining trend tracking. The median filter naturally handles non-stationary signals without requiring parameter adaptation.",
        "what_to_optimize": "False reversals (R), slope changes (S), and noise reduction",
        "cautions": "Median filter window size must be odd. Too aggressive filtering can distort signal. Cascade stages need different window sizes for effectiveness. May introduce slight lag.",
        "approach_type": "scipy.signal.medfilt"
      }
    ],
